# Copy to .env and adjust. Never commit .env.

DATABASE_URL=postgresql+psycopg://sankhya:sankhya@localhost:5433/sankhya
REDIS_URL=redis://localhost:6380/0

# Change this. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# Email. Delivery goes through Resend; leave EMAIL_ENABLED=false for local work
# and the API returns codes and confirmation links in the response instead of
# sending them, so a demo never waits on an email arriving over venue wifi.
# A deployment with APP_ENV=production refuses to start in that state.
EMAIL_ENABLED=false
RESEND_API_KEY=
# Must be a domain verified in the Resend dashboard, or sending returns 403.
EMAIL_FROM=SANKHYA <onboarding@resend.dev>
EMAIL_REPLY_TO=

# Where links in emails point — the browser origin, not the API's.
PUBLIC_APP_URL=http://localhost:3000

# Browser origins allowed to call the API, comma-separated. Empty means the
# local Vite server; production requires this to be set explicitly.
CORS_ORIGINS=

# Self-registration is limited to these domain suffixes, so an arbitrary
# address cannot create an officer record. Empty means any domain.
ALLOWED_EMAIL_DOMAINS=gov.in,nic.in
REGISTRATION_OPEN=true

# Local ML runtime. Ollama runs natively on the host for GPU access.
OLLAMA_BASE_URL=http://localhost:11434
# 3B rather than 7B: 6 GB of VRAM has to hold this alongside Whisper and
# whatever the desktop is using. Swap to qwen2.5:7b-instruct-q4_K_M if you
# have headroom — it is one line and nothing else changes.
JUDGE_MODEL=qwen2.5:3b-instruct-q4_K_M

APP_ENV=dev

# Disfluency counting. Whisper deletes "um" and "uh", so fluency needs a
# second acoustic pass. Indian English model, because that is what the
# officers being assessed actually speak.
VOSK_MODEL_PATH=./models/vosk-model-small-en-in-0.4
