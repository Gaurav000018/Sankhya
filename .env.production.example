# SANKHYA — production environment.
#
#   cp .env.production.example .env
#
# The API refuses to start with APP_ENV=production if any of the REQUIRED
# values below are missing or still set to a development placeholder. That is
# deliberate: a crash loop is loud, whereas signing tokens with a public secret
# is silent and every session issued that way is forgeable.
#
# Never commit the filled-in file. Everything marked REQUIRED is a secret.

APP_ENV=production

# --- REQUIRED: signing key -------------------------------------------------- #
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing session, which is the correct
# response to a suspected leak.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# --- REQUIRED: data stores -------------------------------------------------- #
# Managed Postgres 16+ with the pgvector extension available. `sslmode=require`
# is not optional over a public network — officer competency records travel on
# this connection.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/sankhya?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379/0

# --- REQUIRED: browser origins ---------------------------------------------- #
# Comma-separated, scheme included, no trailing slash. Never "*": these
# endpoints carry credentials.
CORS_ORIGINS=https://sankhya.example.gov.in

# Where links in emails point — the browser-facing origin, not the API's.
# A verification link pointing at the API host lands the officer on raw JSON.
PUBLIC_APP_URL=https://sankhya.example.gov.in

# --- REQUIRED: email (Resend) ------------------------------------------------ #
# EMAIL_ENABLED=false means codes and confirmation links are written to the log
# instead of sent, so nobody could complete registration. Production refuses to
# boot in that state.
EMAIL_ENABLED=true
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The domain must be verified in the Resend dashboard (DNS: SPF + DKIM), or
# every send comes back 403.
EMAIL_FROM=SANKHYA <no-reply@sankhya.example.gov.in>
EMAIL_REPLY_TO=support@sankhya.example.gov.in

# --- registration policy ----------------------------------------------------- #
# Comma-separated domain suffixes allowed to self-register. `gov.in` also
# admits `mospi.gov.in`. Empty means any domain — an explicit opt-out, not a
# default.
ALLOWED_EMAIL_DOMAINS=gov.in,nic.in
# false disables self-service signup entirely, for a deployment that provisions
# officers through an administrator instead.
REGISTRATION_OPEN=true
EMAIL_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2
PASSWORD_MIN_LENGTH=10

# --- abuse limits ------------------------------------------------------------ #
# Counted per email and per client IP, whichever trips first.
LOGIN_MAX_PER_15MIN=10
REGISTER_MAX_PER_HOUR=5
RESET_MAX_PER_HOUR=5
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# --- optional: local ML ------------------------------------------------------- #
# The AI interview and question generation need Ollama reachable from the API,
# and the speech worker running next to a GPU. Leave as-is if those features are
# not being served; everything else works without them.
OLLAMA_BASE_URL=http://ollama:11434
JUDGE_MODEL=qwen2.5:3b-instruct-q4_K_M
VOSK_MODEL_PATH=/models/vosk-model-small-en-in-0.4
