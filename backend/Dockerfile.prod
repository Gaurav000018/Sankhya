# Production image for the SANKHYA API.
#
# Differences from the development Dockerfile, each for a reason:
#
#   * Two stages, so the C toolchain needed to build argon2-cffi and psycopg
#     does not ship in the running image.
#   * A non-root user. A container breakout is worth less when the process
#     inside it cannot write to its own code.
#   * Migrations run on boot via the entrypoint, not `create_all` — which adds
#     missing tables but never alters existing ones, so a changed column would
#     fail at query time instead of at deploy.
#   * Real workers. `--reload` watches the filesystem and serves single-threaded.

# --------------------------------------------------------------- build ----- #
FROM python:3.12-slim AS build

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt

# -------------------------------------------------------------- runtime ---- #
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    APP_ENV=production

# curl is kept for the container healthcheck below; libpq for psycopg's
# runtime. Neither pulls in a compiler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 sankhya

COPY --from=build /opt/venv /opt/venv

WORKDIR /app
COPY --chown=sankhya:sankhya . .

USER sankhya
EXPOSE 8000

# Liveness only — /health does not touch the database, so a brief Postgres
# problem does not get every container killed mid-incident.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips", "*"]
